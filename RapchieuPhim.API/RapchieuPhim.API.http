@RapchieuPhim.API_HostAddress = http://localhost:5162

# =========================================================================
# AUTHENTICATION
# =========================================================================

# @name loginAdmin
POST {{RapchieuPhim.API_HostAddress}}/api/Auth/Login
Content-Type: application/json

{
  "email": "admin@123.com",
  "password": "admin123"
}

###

@adminToken = {{loginAdmin.response.body.token}}


# =========================================================================
# PUBLIC SEAT APIS (NO AUTHENTICATION REQUIRED)
# =========================================================================

### 1. Get All Seats
GET {{RapchieuPhim.API_HostAddress}}/api/Seats
Accept: application/json

###

### 2. Get Seat By ID
# Replace "1" with an existing seat ID
GET {{RapchieuPhim.API_HostAddress}}/api/Seats/1
Accept: application/json

###

### 3. Get Seats By Room ID
# Replace "1" with an existing room ID
GET {{RapchieuPhim.API_HostAddress}}/api/Seats/ByRoom/1
Accept: application/json

###

### 4. Get Seat Layout By Room ID
# Replace "1" with an existing room ID
GET {{RapchieuPhim.API_HostAddress}}/api/Seats/Layout/1
Accept: application/json

###

### 5. Get Available Seats By Showtime ID
# Replace "1" with an existing showtime ID
GET {{RapchieuPhim.API_HostAddress}}/api/Seats/Available/1
Accept: application/json

###


# =========================================================================
# ADMIN SEAT APIS (ADMIN BEARER TOKEN REQUIRED)
# =========================================================================

### 6. Create A Single Seat
POST {{RapchieuPhim.API_HostAddress}}/api/Seats
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roomId": 1,
  "seatRow": "A",
  "seatNumber": "A10",
  "seatType": "Standard",
  "isActive": true
}

###

### 7. Create Batch Seats (Create a whole room layout)
POST {{RapchieuPhim.API_HostAddress}}/api/Seats/Batch
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roomId": 1,
  "rows": ["A", "B", "C"],
  "seatsPerRow": 8,
  "seatType": "Standard"
}

###

### 8. Update A Seat
# Replace "1" with an existing seat ID
PUT {{RapchieuPhim.API_HostAddress}}/api/Seats/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "seatRow": "A",
  "seatNumber": "A1",
  "seatType": "VIP",
  "isActive": true
}

###

### 9. Update Seat Type In Batch
PATCH {{RapchieuPhim.API_HostAddress}}/api/Seats/BatchType
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "seatIds": [1, 2, 3],
  "seatType": "Couple"
}

###

### 10. Toggle Seat Active Status In Batch
PATCH {{RapchieuPhim.API_HostAddress}}/api/Seats/BatchStatus
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "seatIds": [1, 2, 3],
  "isActive": false
}

###

### 11. Delete A Seat
# Replace "1" with an existing seat ID
DELETE {{RapchieuPhim.API_HostAddress}}/api/Seats/1
Authorization: Bearer {{adminToken}}
